# Database Configuration
# Static game data - same path for all environments
DB_PATH=./data/osrs.db
DB_CACHE_SIZE=10000
DB_WAL_MODE=true
DB_MMAP_SIZE=268435456
DB_PAGE_SIZE=4096
DB_AUTO_VACUUM=incremental

# API Configuration
PORT=3000
CORS_ORIGIN=*
CORS_CREDENTIALS=false
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
REQUEST_SIZE_LIMIT=1048576

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=true

# Cache Configuration
CACHE_TTL=300000
CACHE_MAX_SIZE=1000
IMAGE_CACHE_TTL=600000

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_TIMING=false

# Environment
NODE_ENV=development 